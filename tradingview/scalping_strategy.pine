//@version=6
strategy("AI Trading Scanner — AMD Scalping Strategy", overlay=true, pyramiding=0, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, process_orders_on_close=true, calc_on_order_fills=true, max_boxes_count=20, max_labels_count=100, max_lines_count=100)

// Backtest strategy, not a guarantee of future results.
// Defaults are designed for liquid 1m and 5m instruments. Set realistic costs for your broker.
groupTest = "Backtest"
startDate = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Start date", group=groupTest)
endDate = input.time(timestamp("31 Dec 2099 23:59 +0000"), "End date", group=groupTest)
restrictTimeframes = input.bool(true, "Only trade 1m / 5m", group=groupTest)

groupTrend = "Scalping filters"
trendTimeframe = input.timeframe("60", "Higher-timeframe trend", group=groupTrend)
htfFastLength = input.int(50, "HTF fast EMA", minval=1, group=groupTrend)
htfSlowLength = input.int(200, "HTF slow EMA", minval=2, group=groupTrend)
entryEmaLength = input.int(20, "Entry EMA", minval=1, group=groupTrend)
tradeSession = input.session("0700-1700", "Trade session", group=groupTrend)
sessionTimezone = input.string("America/New_York", "Session timezone", group=groupTrend)
minimumRelativeAtr = input.float(0.80, "Minimum ATR vs. its 50-bar average", minval=0.1, step=0.05, group=groupTrend)

groupStructure = "Structure and AMD"
leftBars = input.int(3, "Swing left bars", minval=1, group=groupStructure)
rightBars = input.int(3, "Swing right bars", minval=1, group=groupStructure)
cooldownBars = input.int(12, "Cooldown (bars)", minval=0, group=groupStructure)
minimumStructureConfirmations = input.int(1, "Extra confirmations after break", minval=1, maxval=2, group=groupStructure)
amdTimeframe = input.timeframe("240", "AMD reference timeframe", group=groupStructure)
wickToleranceTicks = input.int(0, "Wick tolerance (ticks)", minval=0, maxval=10, group=groupStructure)
minimumAmdConfirmations = input.int(2, "AMD confirmations", minval=1, maxval=3, group=groupStructure)
enableAmdShorts = input.bool(true, "Enable AMD shorts", group=groupStructure)

groupRisk = "Risk and exits"
atrLength = input.int(14, "ATR length", minval=1, group=groupRisk)
minimumRiskAtr = input.float(0.75, "Minimum stop distance (ATR)", minval=0.1, step=0.05, group=groupRisk)
tp1R = input.float(1.0, "TP1 (R)", minval=0.25, step=0.25, group=groupRisk)
tp2R = input.float(1.5, "TP2 (R)", minval=0.5, step=0.25, group=groupRisk)
tp3R = input.float(2.0, "TP3 (R)", minval=0.75, step=0.25, group=groupRisk)

isScalpTf = timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 5)
timeframeAllowed = not restrictTimeframes or isScalpTf
dateAllowed = time >= startDate and time <= endDate
sessionAllowed = not na(time(timeframe.period, tradeSession, sessionTimezone))
atr = ta.atr(atrLength)
relativeAtr = atr / close
relativeAtrAverage = ta.sma(relativeAtr, 50)
volatilityAllowed = not na(relativeAtrAverage) and relativeAtr >= relativeAtrAverage * minimumRelativeAtr

// No lookahead: the higher timeframe only confirms directional bias.
htfClose = request.security(syminfo.tickerid, trendTimeframe, close)
htfFastEma = request.security(syminfo.tickerid, trendTimeframe, ta.ema(close, htfFastLength))
htfSlowEma = request.security(syminfo.tickerid, trendTimeframe, ta.ema(close, htfSlowLength))
trendLong = htfClose > htfFastEma and htfFastEma > htfSlowEma
trendShort = htfClose < htfFastEma and htfFastEma < htfSlowEma
entryEma = ta.ema(close, entryEmaLength)

swingHigh = ta.pivothigh(high, leftBars, rightBars)
swingLow = ta.pivotlow(low, leftBars, rightBars)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow := swingLow

bullishBreak = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearishBreak = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
sweepLow = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow
sweepHigh = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bullishFvg = low > high[2]
bearishFvg = high < low[2]
longConfirmationScore = (sweepLow ? 1 : 0) + (bullishFvg ? 1 : 0)
shortConfirmationScore = (sweepHigh ? 1 : 0) + (bearishFvg ? 1 : 0)

// AMD: a completed 4H candle with no lower wick. Its low is a potential downside target.
higherPreviousTime = request.security(syminfo.tickerid, amdTimeframe, time[1])
higherPreviousLow = request.security(syminfo.tickerid, amdTimeframe, low[1])
higherNoLowerWick = request.security(syminfo.tickerid, amdTimeframe, low[1] >= math.min(open[1], close[1]) - syminfo.mintick * wickToleranceTicks)
var int processedHigherTime = na
var float amdTargetLow = na
var bool amdTargetActive = false
if not na(higherPreviousTime) and higherPreviousTime != processedHigherTime
    processedHigherTime := higherPreviousTime
    if higherNoLowerWick
        amdTargetLow := higherPreviousLow
        amdTargetActive := true

var int lastSignalBar = na
cooldownComplete = na(lastSignalBar) or bar_index - lastSignalBar >= cooldownBars
commonFilters = barstate.isconfirmed and timeframeAllowed and dateAllowed and sessionAllowed and volatilityAllowed and strategy.position_size == 0
longSignal = commonFilters and trendLong and close > entryEma and bullishBreak and longConfirmationScore >= minimumStructureConfirmations
amdShortSignal = enableAmdShorts and amdTargetActive and close > amdTargetLow and trendShort and shortConfirmationScore >= minimumAmdConfirmations
shortSignal = commonFilters and trendShort and close < entryEma and bearishBreak and shortConfirmationScore >= minimumStructureConfirmations
enterLong = cooldownComplete and longSignal
enterShort = cooldownComplete and (amdShortSignal or shortSignal)

var int activeDirection = 0
var float activeEntry = na
var float activeStop = na
var float activeTp1 = na
var float activeTp2 = na
var float activeTp3 = na
var box profitBox = na
var box riskBox = na
var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line stopLine = na

if enterLong or enterShort
    bool isLong = enterLong and not enterShort
    lastSignalBar := bar_index
    activeDirection := isLong ? 1 : -1
    activeEntry := math.round_to_mintick(close)
    longStop = math.min(low, nz(lastSwingLow, low))
    shortStop = math.max(high, nz(lastSwingHigh, high))
    activeStop := math.round_to_mintick(isLong ? math.min(longStop, activeEntry - atr * minimumRiskAtr) : math.max(shortStop, activeEntry + atr * minimumRiskAtr))
    risk = math.abs(activeEntry - activeStop)
    activeTp1 := math.round_to_mintick(isLong ? activeEntry + risk * tp1R : activeEntry - risk * tp1R)
    activeTp2 := math.round_to_mintick(isLong ? activeEntry + risk * tp2R : activeEntry - risk * tp2R)
    activeTp3 := math.round_to_mintick(isLong ? activeEntry + risk * tp3R : amdShortSignal ? math.min(amdTargetLow, activeEntry - risk * tp3R) : activeEntry - risk * tp3R)
    if isLong
        strategy.entry("Long", strategy.long, alert_message="LONG scalp setup")
        strategy.exit("L-TP1", "Long", limit=activeTp1, stop=activeStop, qty_percent=33)
        strategy.exit("L-TP2", "Long", limit=activeTp2, stop=activeStop, qty_percent=33)
        strategy.exit("L-TP3", "Long", limit=activeTp3, stop=activeStop, qty_percent=34)
    else
        strategy.entry("Short", strategy.short, alert_message="SHORT scalp setup")
        strategy.exit("S-TP1", "Short", limit=activeTp1, stop=activeStop, qty_percent=33)
        strategy.exit("S-TP2", "Short", limit=activeTp2, stop=activeStop, qty_percent=33)
        strategy.exit("S-TP3", "Short", limit=activeTp3, stop=activeStop, qty_percent=34)
    profitBox := box.new(bar_index, math.max(activeEntry, activeTp3), bar_index + 1, math.min(activeEntry, activeTp3), border_color=color.new(color.lime, 45), bgcolor=color.new(color.lime, 88))
    riskBox := box.new(bar_index, math.max(activeEntry, activeStop), bar_index + 1, math.min(activeEntry, activeStop), border_color=color.new(color.red, 45), bgcolor=color.new(color.red, 88))
    entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, color=color.blue, width=2)
    tp1Line := line.new(bar_index, activeTp1, bar_index + 1, activeTp1, color=color.lime, style=line.style_dashed)
    tp2Line := line.new(bar_index, activeTp2, bar_index + 1, activeTp2, color=color.orange, style=line.style_dashed)
    tp3Line := line.new(bar_index, activeTp3, bar_index + 1, activeTp3, color=color.purple, style=line.style_dashed)
    stopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, color=color.red, style=line.style_dashed)
    label.new(bar_index, activeEntry, isLong ? "BUY" : "SELL", style=isLong ? label.style_label_up : label.style_label_down, color=isLong ? color.green : color.red, textcolor=color.white)

if activeDirection != 0
    box.set_right(profitBox, bar_index)
    box.set_right(riskBox, bar_index)
    line.set_x2(entryLine, bar_index)
    line.set_x2(tp1Line, bar_index)
    line.set_x2(tp2Line, bar_index)
    line.set_x2(tp3Line, bar_index)
    line.set_x2(stopLine, bar_index)
    if strategy.position_size == 0 and strategy.position_size[1] != 0
        activeDirection := 0
        if amdShortSignal
            amdTargetActive := false

plot(amdTargetActive ? amdTargetLow : na, "AMD 4H Target", color=color.new(color.purple, 10), linewidth=2, style=plot.style_linebr)
plot(lastSwingHigh, "Last swing high", color=color.new(color.red, 65), style=plot.style_linebr)
plot(lastSwingLow, "Last swing low", color=color.new(color.lime, 65), style=plot.style_linebr)
plotshape(enterLong, title="Long setup", text="LONG", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(enterShort, title="Short setup", text="SHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

alertcondition(enterLong, "AMD Scalping LONG", "AMD scalping LONG setup")
alertcondition(enterShort, "AMD Scalping SHORT", "AMD scalping SHORT setup")

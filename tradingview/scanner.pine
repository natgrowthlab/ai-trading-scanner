//@version=6
indicator("AI Trading Scanner", overlay=true, max_boxes_count=50, max_labels_count=200, max_lines_count=200)

// Tuned for the requested execution timeframes.
restrictTimeframes = input.bool(true, "Only run on 1m, 5m, 1h and 1D")
leftBars = input.int(3, "Swing left bars", minval=1)
rightBars = input.int(3, "Swing right bars", minval=1)
atrLength = input.int(14, "ATR length", minval=1)
gapAtr = input.float(0.25, "Minimum FVG ATR ratio", minval=0)
showFvg = input.bool(true, "Show fair value gaps")
showOrderBlocks = input.bool(true, "Show order blocks")
orderBlockLookback = input.int(20, "Order block candle search", minval=2, maxval=100)
maxHighConfidenceOrderBlocks = input.int(6, "Maximum high-confidence OBs", minval=1, maxval=20, group="High-confidence order blocks")
obMinDisplacementAtr = input.float(1.20, "Minimum BOS displacement (ATR)", minval=0.25, step=0.05, group="High-confidence order blocks")
obMinRelativeVolume = input.float(1.25, "Minimum BOS relative volume", minval=0.5, step=0.05, group="High-confidence order blocks")
obMinOriginBodyAtr = input.float(0.35, "Minimum origin candle body (ATR)", minval=0.05, step=0.05, group="High-confidence order blocks")
obMinOriginRelativeVolume = input.float(1.00, "Minimum origin candle relative volume", minval=0.5, step=0.05, group="High-confidence order blocks")
obMinScore = input.int(4, "Minimum OB confidence checks", minval=2, maxval=4, group="High-confidence order blocks")
requireHighConfidenceObForSignals = input.bool(true, "Require high-confidence OB for LONG/SHORT", group="High-confidence order blocks")
retestWindowBars = input.int(24, "OB retest window (bars)", minval=1, maxval=200, group="Signal confirmation")
requireObRetest = input.bool(true, "Require OB retest for LONG/SHORT", group="Signal confirmation")
higherTimeframe = input.timeframe("60", "Higher timeframe bias", group="Signal confirmation")
filterSignalSessions = input.bool(true, "Limit intraday signals to London / New York", group="Signal confirmation")
londonSession = input.session("0800-1200", "London session", group="Signal confirmation")
newYorkSession = input.session("0830-1200", "New York session", group="Signal confirmation")
minimumSignalScore = input.int(5, "Minimum signal score (out of 6)", minval=3, maxval=6, group="Signal confirmation")
signalCooldownBars = input.int(10, "Cooldown after a signal (bars)", minval=0, maxval=200, group="Signal confirmation")
showTradePlan = input.bool(true, "Show entry, SL and TP1/TP2/TP3", group="Signal confirmation")
showSessionLevels = input.bool(true, "Show session high / low")
sessionInput = input.session("0000-2359", "Session")
sessionTimezone = input.string("Etc/UTC", "Session timezone")
showTrendStructure = input.bool(true, "Show trendlines, ceilings and floors")
webhookSecret = input.string("", "Webhook secret", group="Automation", tooltip="Use the same secret configured in the scanner Web App. This value is only included in alert() webhook messages.")

supportedTimeframe = (timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 5 or timeframe.multiplier == 60)) or timeframe.isdaily
active = not restrictTimeframes or supportedTimeframe
atr = ta.atr(atrLength)

// Reset the high and low at each configured session start, and extend the levels right.
inSession = not na(time(timeframe.period, sessionInput, sessionTimezone))
sessionStarted = inSession and not inSession[1]
var float sessionHigh = na
var float sessionLow = na
var line sessionHighLine = na
var line sessionLowLine = na
if active and showSessionLevels and (sessionStarted or na(sessionHighLine))
    sessionHigh := high
    sessionLow := low
    line.delete(sessionHighLine)
    line.delete(sessionLowLine)
    sessionHighLine := line.new(bar_index, sessionHigh, bar_index + 1, sessionHigh, extend=extend.right, color=color.aqua, style=line.style_dashed)
    sessionLowLine := line.new(bar_index, sessionLow, bar_index + 1, sessionLow, extend=extend.right, color=color.aqua, style=line.style_dashed)
else if active and showSessionLevels and inSession
    sessionHigh := math.max(nz(sessionHigh, high), high)
    sessionLow := math.min(nz(sessionLow, low), low)
    line.set_y1(sessionHighLine, sessionHigh)
    line.set_y2(sessionHighLine, sessionHigh)
    line.set_y1(sessionLowLine, sessionLow)
    line.set_y2(sessionLowLine, sessionLow)

// Confirmed pivots build trendlines plus the active ceiling and floor.
swingHigh = active ? ta.pivothigh(high, leftBars, rightBars) : na
swingLow = active ? ta.pivotlow(low, leftBars, rightBars) : na
var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var line ceilingLine = na
var line floorLine = na

if not na(swingHigh)
    pivotBar = bar_index - rightBars
    if showTrendStructure and not na(lastHigh)
        line.new(lastHighBar, lastHigh, pivotBar, swingHigh, color=color.new(color.red, 20), width=2)
    line.delete(ceilingLine)
    ceilingLine := line.new(pivotBar, swingHigh, bar_index, swingHigh, extend=extend.right, color=color.new(color.red, 35), style=line.style_dotted, width=2)
    label.new(pivotBar, swingHigh, "CEILING\nSH", style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    lastHigh := swingHigh
    lastHighBar := pivotBar

if not na(swingLow)
    pivotBar = bar_index - rightBars
    if showTrendStructure and not na(lastLow)
        line.new(lastLowBar, lastLow, pivotBar, swingLow, color=color.new(color.lime, 20), width=2)
    line.delete(floorLine)
    floorLine := line.new(pivotBar, swingLow, bar_index, swingLow, extend=extend.right, color=color.new(color.lime, 35), style=line.style_dotted, width=2)
    label.new(pivotBar, swingLow, "FLOOR\nSL", style=label.style_label_up, color=color.new(color.lime, 15), textcolor=color.white, size=size.tiny)
    lastLow := swingLow
    lastLowBar := pivotBar

bullishBos = active and not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bearishBos = active and not na(lastLow) and close < lastLow and close[1] >= lastLow
volumeAverage = ta.sma(volume, 20)
relativeVolume = not na(volumeAverage) and volumeAverage > 0 ? volume / volumeAverage : 0.0
bosDisplacementAtr = atr > 0 ? math.abs(close - open) / atr : 0.0
if bullishBos
    label.new(bar_index, high, "BOS +", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.tiny)
if bearishBos
    label.new(bar_index, low, "BOS −", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)

// Fair value gaps.
bullishFvg = active and low > high[2] and (low - high[2]) / atr >= gapAtr
bearishFvg = active and high < low[2] and (low[2] - high) / atr >= gapAtr
var float latestBullishFvgTop = na
var float latestBullishFvgBottom = na
var int latestBullishFvgBar = na
var float latestBearishFvgTop = na
var float latestBearishFvgBottom = na
var int latestBearishFvgBar = na
if showFvg and bullishFvg
    box.new(bar_index - 2, low, bar_index, high[2], extend=extend.right, border_color=color.new(color.green, 45), bgcolor=color.new(color.green, 88))
if showFvg and bearishFvg
    box.new(bar_index - 2, low[2], bar_index, high, extend=extend.right, border_color=color.new(color.red, 45), bgcolor=color.new(color.red, 88))
if bullishFvg
    latestBullishFvgTop := low
    latestBullishFvgBottom := high[2]
    latestBullishFvgBar := bar_index
if bearishFvg
    latestBearishFvgTop := low[2]
    latestBearishFvgBottom := high
    latestBearishFvgBar := bar_index

// Only retain an OB when a confirmed BOS is accompanied by displacement and volume.
// The origin candle is also scored, so ordinary opposite candles do not create zones.
var box[] orderBlocks = array.new_box()
createOrderBlock(isBullish, shouldEvaluate) =>
    int offset = na
    bool created = false
    float blockTop = na
    float blockBottom = na
    bool fvgConfluence = false
    box createdBox = na
    if shouldEvaluate
        for i = 1 to orderBlockLookback
            oppositeCandle = isBullish ? close[i] < open[i] : close[i] > open[i]
            if na(offset) and oppositeCandle
                offset := i
    if shouldEvaluate and not na(offset)
        originBodyAtr = not na(atr[offset]) and atr[offset] > 0 ? math.abs(close[offset] - open[offset]) / atr[offset] : 0.0
        originVolumeAverage = volumeAverage[offset]
        originRelativeVolume = not na(originVolumeAverage) and originVolumeAverage > 0 ? volume[offset] / originVolumeAverage : 0.0
        int confidenceChecks = 0
        if bosDisplacementAtr >= obMinDisplacementAtr
            confidenceChecks += 1
        if relativeVolume >= obMinRelativeVolume
            confidenceChecks += 1
        if originBodyAtr >= obMinOriginBodyAtr
            confidenceChecks += 1
        if originRelativeVolume >= obMinOriginRelativeVolume
            confidenceChecks += 1
        if confidenceChecks >= obMinScore
            created := true
            blockTop := math.max(open[offset], close[offset])
            blockBottom := math.min(open[offset], close[offset])
            fvgTop = isBullish ? latestBullishFvgTop : latestBearishFvgTop
            fvgBottom = isBullish ? latestBullishFvgBottom : latestBearishFvgBottom
            fvgBar = isBullish ? latestBullishFvgBar : latestBearishFvgBar
            fvgConfluence := not na(fvgTop) and not na(fvgBottom) and not na(fvgBar) and bar_index - fvgBar <= orderBlockLookback and blockTop >= fvgBottom and blockBottom <= fvgTop
            if showOrderBlocks
                blockColor = isBullish ? color.green : color.red
                blockText = "BULLISH OB"
                if not isBullish
                    blockText := "BEARISH OB"
                createdBox := box.new(bar_index - offset, blockTop, bar_index, blockBottom, extend=extend.right, border_color=color.new(blockColor, 10), bgcolor=color.new(blockColor, 80), text=blockText, text_color=color.white, text_size=size.tiny)
                array.push(orderBlocks, createdBox)
                if array.size(orderBlocks) > maxHighConfidenceOrderBlocks
                    box.delete(array.shift(orderBlocks))
    [created, blockTop, blockBottom, fvgConfluence, createdBox]

[highConfidenceBullishOb, bullishObTop, bullishObBottom, bullishObFvg, bullishObBox] = createOrderBlock(true, bullishBos)
[highConfidenceBearishOb, bearishObTop, bearishObBottom, bearishObFvg, bearishObBox] = createOrderBlock(false, bearishBos)

var float activeBullishObTop = na
var float activeBullishObBottom = na
var int activeBullishObBar = na
var bool activeBullishObFvg = false
var bool activeBullishObValid = false
var box activeBullishObBox = na
var float activeBearishObTop = na
var float activeBearishObBottom = na
var int activeBearishObBar = na
var bool activeBearishObFvg = false
var bool activeBearishObValid = false
var box activeBearishObBox = na
if highConfidenceBullishOb
    activeBullishObTop := bullishObTop
    activeBullishObBottom := bullishObBottom
    activeBullishObBar := bar_index
    activeBullishObFvg := bullishObFvg
    activeBullishObValid := true
    activeBullishObBox := bullishObBox
if highConfidenceBearishOb
    activeBearishObTop := bearishObTop
    activeBearishObBottom := bearishObBottom
    activeBearishObBar := bar_index
    activeBearishObFvg := bearishObFvg
    activeBearishObValid := true
    activeBearishObBox := bearishObBox

if not na(activeBullishObBottom) and close < activeBullishObBottom
    box.delete(activeBullishObBox)
    activeBullishObTop := na
    activeBullishObBottom := na
    activeBullishObBar := na
    activeBullishObValid := false
if not na(activeBearishObTop) and close > activeBearishObTop
    box.delete(activeBearishObBox)
    activeBearishObTop := na
    activeBearishObBottom := na
    activeBearishObBar := na
    activeBearishObValid := false

bullishObRetest = not na(activeBullishObTop) and bar_index > activeBullishObBar and bar_index - activeBullishObBar <= retestWindowBars and low <= activeBullishObTop and high >= activeBullishObBottom and close > open and close >= (activeBullishObTop + activeBullishObBottom) / 2
bearishObRetest = not na(activeBearishObTop) and bar_index > activeBearishObBar and bar_index - activeBearishObBar <= retestWindowBars and high >= activeBearishObBottom and low <= activeBearishObTop and close < open and close <= (activeBearishObTop + activeBearishObBottom) / 2
if bullishObRetest
    box.set_bgcolor(activeBullishObBox, color.new(color.green, 92))
if bearishObRetest
    box.set_bgcolor(activeBearishObBox, color.new(color.red, 92))

ema20 = ta.ema(close, 20)
higherTimeframeBullish = request.security(syminfo.tickerid, higherTimeframe, close > ta.ema(close, 20))
higherTimeframeBearish = request.security(syminfo.tickerid, higherTimeframe, close < ta.ema(close, 20))
inLondon = not na(time(timeframe.period, londonSession, "Europe/London"))
inNewYork = not na(time(timeframe.period, newYorkSession, "America/New_York"))
signalSessionAllowed = not filterSignalSessions or timeframe.isdaily or inLondon or inNewYork
longEntryPattern = requireObRetest ? bullishObRetest : highConfidenceBullishOb
shortEntryPattern = requireObRetest ? bearishObRetest : highConfidenceBearishOb
longScore = (activeBullishObValid ? 1 : 0) + (bullishObRetest ? 1 : 0) + (close > ema20 ? 1 : 0) + (higherTimeframeBullish ? 1 : 0) + (activeBullishObFvg ? 1 : 0) + (signalSessionAllowed ? 1 : 0)
shortScore = (activeBearishObValid ? 1 : 0) + (bearishObRetest ? 1 : 0) + (close < ema20 ? 1 : 0) + (higherTimeframeBearish ? 1 : 0) + (activeBearishObFvg ? 1 : 0) + (signalSessionAllowed ? 1 : 0)
var int lastSignalBar = na
cooldownComplete = na(lastSignalBar) or bar_index - lastSignalBar >= signalCooldownBars

longSignal = barstate.isconfirmed and longEntryPattern and close > ema20 and higherTimeframeBullish and signalSessionAllowed and longScore >= minimumSignalScore and cooldownComplete and (not requireHighConfidenceObForSignals or activeBullishObValid)
shortSignal = barstate.isconfirmed and shortEntryPattern and close < ema20 and higherTimeframeBearish and signalSessionAllowed and shortScore >= minimumSignalScore and cooldownComplete and (not requireHighConfidenceObForSignals or activeBearishObValid)
stopPrice = longSignal ? activeBullishObBottom : shortSignal ? activeBearishObTop : na
if longSignal or shortSignal
    lastSignalBar := bar_index
    directionText = longSignal ? "LONG " : "SHORT "
    signalScore = longSignal ? longScore : shortScore
    label.new(bar_index, longSignal ? low : high, directionText + str.tostring(signalScore) + "/6", style=longSignal ? label.style_label_up : label.style_label_down, color=longSignal ? color.green : color.red, textcolor=color.white, size=size.tiny)
    if showTradePlan
        entryPrice = close
        riskDistance = math.abs(entryPrice - stopPrice)
        line.new(bar_index, entryPrice, bar_index + 1, entryPrice, extend=extend.right, color=color.white, style=line.style_dotted)
        line.new(bar_index, stopPrice, bar_index + 1, stopPrice, extend=extend.right, color=color.red, style=line.style_dashed)
        tp1 = longSignal ? entryPrice + riskDistance : entryPrice - riskDistance
        tp2 = longSignal ? entryPrice + riskDistance * 2 : entryPrice - riskDistance * 2
        tp3 = longSignal ? entryPrice + riskDistance * 3 : entryPrice - riskDistance * 3
        line.new(bar_index, tp1, bar_index + 1, tp1, extend=extend.right, color=color.new(color.green, 10), style=line.style_dotted)
        line.new(bar_index, tp2, bar_index + 1, tp2, extend=extend.right, color=color.new(color.green, 25), style=line.style_dotted)
        line.new(bar_index, tp3, bar_index + 1, tp3, extend=extend.right, color=color.new(color.green, 40), style=line.style_dotted)
plotshape(longSignal, title="Long", text="LONG", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(shortSignal, title="Short", text="SHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)
plot(stopPrice, "Stop Loss", display=display.none)

alertcondition(longSignal, "AI Scanner Long", '{"event":"SIGNAL","direction":"LONG","symbol":"{{ticker}}","timeframe":"{{interval}}","price":"{{close}}","stop_loss":{{plot("Stop Loss")}}}')
alertcondition(shortSignal, "AI Scanner Short", '{"event":"SIGNAL","direction":"SHORT","symbol":"{{ticker}}","timeframe":"{{interval}}","price":"{{close}}","stop_loss":{{plot("Stop Loss")}}}')

// Dynamic alert() messages include the configured secret and live calculated stop.
// Create one TradingView alert using "Any alert() function call" after saving the script.
if barstate.isconfirmed and webhookSecret != "" and longSignal
    longMessage = '{"secret":"' + webhookSecret + '","event":"SIGNAL","direction":"LONG","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(stopPrice) + '}'
    alert(longMessage, alert.freq_once_per_bar_close)
if barstate.isconfirmed and webhookSecret != "" and shortSignal
    shortMessage = '{"secret":"' + webhookSecret + '","event":"SIGNAL","direction":"SHORT","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"stop_loss":' + str.tostring(stopPrice) + '}'
    alert(shortMessage, alert.freq_once_per_bar_close)

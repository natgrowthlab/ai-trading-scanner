//@version=6
indicator("AI Trading Scanner", overlay=true, max_boxes_count=100, max_labels_count=200, max_lines_count=200)

restrictTimeframes = input.bool(true, "Only run on 1m, 5m, 1h and 1D", group="Signals")
leftBars = input.int(3, "Swing left bars", minval=1, group="Signals")
rightBars = input.int(3, "Swing right bars", minval=1, group="Signals")
cooldownBars = input.int(8, "Signal cooldown (bars)", minval=0, group="Signals")
amdTimeframe = input.timeframe("240", "AMD reference timeframe", group="AMD wickless candle")
wickToleranceTicks = input.int(0, "Wick tolerance (ticks)", minval=0, maxval=10, group="AMD wickless candle")
minimumConfirmations = input.int(1, "Lower-timeframe confirmations", minval=1, maxval=3, group="AMD wickless candle")
showAmdTarget = input.bool(true, "Show active 4H AMD target", group="AMD wickless candle")
showStructureFallback = input.bool(true, "Show structure plans when no AMD target", group="Signals")
atrLength = input.int(14, "ATR length", minval=1, group="Trade plan")
minimumRiskAtr = input.float(0.5, "Minimum stop distance (ATR)", minval=0.1, step=0.1, group="Trade plan")
targetRiskReward = input.float(2.0, "Chart target (R)", minval=1.0, step=0.25, group="Trade plan")
showSessionLevels = input.bool(false, "Show session high / low", group="Optional levels")
sessionInput = input.session("0000-2359", "Session", group="Optional levels")
sessionTimezone = input.string("Etc/UTC", "Session timezone", group="Optional levels")
telegramChatId = input.string("", "Telegram chat ID", group="Telegram direct", tooltip="Your private chat or group chat ID. The bot token is never stored in this script; it belongs only in TradingView's Webhook URL.")

supportedTimeframe = (timeframe.isminutes and (timeframe.multiplier == 1 or timeframe.multiplier == 5 or timeframe.multiplier == 60)) or timeframe.isdaily
active = not restrictTimeframes or supportedTimeframe
atr = ta.atr(atrLength)

inSession = not na(time(timeframe.period, sessionInput, sessionTimezone))
sessionStarted = inSession and not inSession[1]
var float sessionHigh = na
var float sessionLow = na
var line sessionHighLine = na
var line sessionLowLine = na
if showSessionLevels and (sessionStarted or na(sessionHigh))
    sessionHigh := high
    sessionLow := low
    line.delete(sessionHighLine)
    line.delete(sessionLowLine)
    sessionHighLine := line.new(bar_index, sessionHigh, bar_index + 1, sessionHigh, extend=extend.right, color=color.new(color.aqua, 35), style=line.style_dashed)
    sessionLowLine := line.new(bar_index, sessionLow, bar_index + 1, sessionLow, extend=extend.right, color=color.new(color.aqua, 35), style=line.style_dashed)
else if showSessionLevels and inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow := math.min(sessionLow, low)
    line.set_y1(sessionHighLine, sessionHigh)
    line.set_y2(sessionHighLine, sessionHigh)
    line.set_y1(sessionLowLine, sessionLow)
    line.set_y2(sessionLowLine, sessionLow)

swingHigh = active ? ta.pivothigh(high, leftBars, rightBars) : na
swingLow = active ? ta.pivotlow(low, leftBars, rightBars) : na
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow := swingLow

bullishBreak = active and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearishBreak = active and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
liquiditySweepHigh = active and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
bearishFvg = active and high < low[2]

// AMD: a completed 4H candle with no lower wick leaves an imbalance target at its low.
higherPreviousTime = request.security(syminfo.tickerid, amdTimeframe, time[1])
higherPreviousLow = request.security(syminfo.tickerid, amdTimeframe, low[1])
higherNoLowerWick = request.security(syminfo.tickerid, amdTimeframe, low[1] >= math.min(open[1], close[1]) - syminfo.mintick * wickToleranceTicks)
var int processedHigherTime = na
var float amdTargetLow = na
var bool amdTargetActive = false
var line amdTargetLine = na
if not na(higherPreviousTime) and higherPreviousTime != processedHigherTime
    processedHigherTime := higherPreviousTime
    if higherNoLowerWick
        amdTargetLow := higherPreviousLow
        amdTargetActive := true
        line.delete(amdTargetLine)
        if showAmdTarget
            amdTargetLine := line.new(bar_index, amdTargetLow, bar_index + 1, amdTargetLow, extend=extend.right, color=color.new(color.purple, 15), style=line.style_dashed, width=2)

var label amdStatusLabel = na
if barstate.islast
    label.delete(amdStatusLabel)
    statusText = amdTargetActive ? "AMD 4H TARGET: " + str.tostring(amdTargetLow) + "\nWaiting lower-TF bearish confirmation" : "AMD: waiting for a closed 4H candle without lower wick"
    amdStatusLabel := label.new(bar_index, high, statusText, style=label.style_label_down, color=amdTargetActive ? color.purple : color.gray, textcolor=color.white, size=size.tiny)

confirmationScore = (liquiditySweepHigh ? 1 : 0) + (bearishBreak ? 1 : 0) + (bearishFvg ? 1 : 0)
var int lastSignalBar = na
cooldownComplete = na(lastSignalBar) or bar_index - lastSignalBar >= cooldownBars
amdShortSignal = amdTargetActive and close > amdTargetLow and confirmationScore >= minimumConfirmations
longSignal = barstate.isconfirmed and cooldownComplete and showStructureFallback and bullishBreak
shortSignal = barstate.isconfirmed and cooldownComplete and (amdShortSignal or (showStructureFallback and bearishBreak))

// One clear risk/reward plan per signal: green target, red stop, blue entry.
var int activeDirection = 0
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeTp1 = na
var float activeTp2 = na
var float activeTp3 = na
var box activeProfitBox = na
var box activeStopBox = na
var line activeEntryLine = na
var line activeTp1Line = na
var line activeTp2Line = na
var line activeTp3Line = na
var line activeStopLine = na
var bool tp1Reached = false
var bool tp2Reached = false
if longSignal or shortSignal
    lastSignalBar := bar_index
    activeDirection := longSignal ? 1 : -1
    activeEntry := math.round_to_mintick(close)
    longStopCandidate = math.min(low, nz(lastSwingLow, low))
    shortStopCandidate = math.max(high, nz(lastSwingHigh, high))
    minimumDistance = atr * minimumRiskAtr
    activeStop := activeDirection == 1 ? math.min(longStopCandidate, activeEntry - minimumDistance) : math.max(shortStopCandidate, activeEntry + minimumDistance)
    activeStop := math.round_to_mintick(activeStop)
    risk = math.abs(activeEntry - activeStop)
    activeTarget := math.round_to_mintick(activeDirection == 1 ? activeEntry + risk * targetRiskReward : amdTargetActive ? amdTargetLow : activeEntry - risk * targetRiskReward)
    targetDistance = math.abs(activeTarget - activeEntry)
    activeTp1 := math.round_to_mintick(activeDirection == 1 ? activeEntry + targetDistance / 3 : activeEntry - targetDistance / 3)
    activeTp2 := math.round_to_mintick(activeDirection == 1 ? activeEntry + targetDistance * 2 / 3 : activeEntry - targetDistance * 2 / 3)
    activeTp3 := activeTarget
    tp1Reached := false
    tp2Reached := false
    activeProfitBox := box.new(bar_index, math.max(activeEntry, activeTarget), bar_index + 1, math.min(activeEntry, activeTarget), border_color=color.new(color.lime, 50), bgcolor=color.new(color.lime, 88))
    activeStopBox := box.new(bar_index, math.max(activeEntry, activeStop), bar_index + 1, math.min(activeEntry, activeStop), border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 88))
    activeEntryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, color=color.blue, width=2)
    activeTp1Line := line.new(bar_index, activeTp1, bar_index + 1, activeTp1, color=color.lime, style=line.style_dashed, width=2)
    activeTp2Line := line.new(bar_index, activeTp2, bar_index + 1, activeTp2, color=color.orange, style=line.style_dashed, width=2)
    activeTp3Line := line.new(bar_index, activeTp3, bar_index + 1, activeTp3, color=color.purple, style=line.style_dashed, width=2)
    activeStopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, color=color.red, style=line.style_dashed, width=2)
    label.new(bar_index + 1, activeEntry, "ENTRY\n" + str.tostring(activeEntry), style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 1, activeTp1, "TP1\n" + str.tostring(activeTp1), style=label.style_label_left, color=color.lime, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 1, activeTp2, "TP2\n" + str.tostring(activeTp2), style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 1, activeTp3, "TP3\n" + str.tostring(activeTp3), style=label.style_label_left, color=color.purple, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 1, activeStop, "SL\n" + str.tostring(activeStop), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    label.new(bar_index, activeEntry, activeDirection == 1 ? "BUY" : "SELL", style=activeDirection == 1 ? label.style_label_up : label.style_label_down, color=activeDirection == 1 ? color.green : color.red, textcolor=color.white, size=size.small)

if activeDirection != 0
    box.set_right(activeProfitBox, bar_index)
    box.set_right(activeStopBox, bar_index)
    line.set_x2(activeEntryLine, bar_index)
    line.set_x2(activeTp1Line, bar_index)
    line.set_x2(activeTp2Line, bar_index)
    line.set_x2(activeTp3Line, bar_index)
    line.set_x2(activeStopLine, bar_index)
    longTargetHit = activeDirection == 1 and high >= activeTarget
    shortTargetHit = activeDirection == -1 and low <= activeTarget
    longStopHit = activeDirection == 1 and low <= activeStop
    shortStopHit = activeDirection == -1 and high >= activeStop
    tp1Hit = activeDirection == 1 ? high >= activeTp1 : low <= activeTp1
    tp2Hit = activeDirection == 1 ? high >= activeTp2 : low <= activeTp2
    if tp1Hit and not tp1Reached
        label.new(bar_index, activeTp1, "TP1 HIT", style=label.style_label_left, color=color.lime, textcolor=color.white, size=size.tiny)
        tp1Reached := true
    if tp2Hit and not tp2Reached
        label.new(bar_index, activeTp2, "TP2 HIT", style=label.style_label_left, color=color.orange, textcolor=color.white, size=size.tiny)
        tp2Reached := true
    if longTargetHit or shortTargetHit
        label.new(bar_index, activeTarget, activeDirection == 1 ? "Long TP" : "Short TP", style=activeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)
        activeDirection := 0
        amdTargetActive := false
        line.delete(amdTargetLine)
    else if longStopHit or shortStopHit
        label.new(bar_index, activeStop, activeDirection == 1 ? "Long SL" : "Short SL", style=activeDirection == 1 ? label.style_label_down : label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
        activeDirection := 0

plotshape(longSignal, title="Long", text="LONG", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(shortSignal, title="Short", text="SHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

// Direct Telegram delivery; set the Bot API URL only in TradingView's alert webhook field.
telegramReasons = "AMD_4H_WICKLESS,LOWER_TF_CONFIRMATION"
if longSignal and telegramChatId != ""
    telegramRisk = math.abs(activeEntry - activeStop)
    longTp1 = math.round_to_mintick(activeEntry + telegramRisk)
    longTp2 = math.round_to_mintick(activeEntry + telegramRisk * 2)
    longTp3 = math.round_to_mintick(activeEntry + telegramRisk * 3)
    longText = "🟢 <b>BUY " + syminfo.ticker + "</b>\\nTF: " + timeframe.period + "\\nEntry: " + str.tostring(activeEntry) + "\\nTP1: " + str.tostring(longTp1) + "\\nTP2: " + str.tostring(longTp2) + "\\nTP3: " + str.tostring(longTp3) + "\\nSL: " + str.tostring(activeStop) + "\\nReason: " + telegramReasons
    longMessage = '{"chat_id":"' + telegramChatId + '","text":"' + longText + '","parse_mode":"HTML","disable_web_page_preview":true}'
    alert(longMessage, alert.freq_once_per_bar_close)
if shortSignal and telegramChatId != ""
    telegramRisk = math.abs(activeEntry - activeStop)
    shortTp1 = math.round_to_mintick(activeEntry - telegramRisk)
    shortTp2 = math.round_to_mintick(activeEntry - telegramRisk * 2)
    shortTp3 = math.round_to_mintick(activeEntry - telegramRisk * 3)
    shortText = "🔴 <b>SELL " + syminfo.ticker + "</b>\\nTF: " + timeframe.period + "\\nEntry: " + str.tostring(activeEntry) + "\\nTP1: " + str.tostring(shortTp1) + "\\nTP2: " + str.tostring(shortTp2) + "\\nTP3: " + str.tostring(shortTp3) + "\\nSL: " + str.tostring(activeStop) + "\\nReason: " + telegramReasons
    shortMessage = '{"chat_id":"' + telegramChatId + '","text":"' + shortText + '","parse_mode":"HTML","disable_web_page_preview":true}'
    alert(shortMessage, alert.freq_once_per_bar_close)

# Public Binance USDT-M Futures market data requires no key. Do not expose private API keys as NEXT_PUBLIC_* values.
# Optional server-side override for the market-data host. The built-in public fallbacks remain active.
BINANCE_PUBLIC_API_BASE_URL=
# Testnet only. These are read only by the server-side credential verifier.
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
